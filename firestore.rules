rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de utilizador: leitura pública, edição apenas pelo titular
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Tier lists: leitura pública para listas públicas/não listadas,
    // criação por qualquer utilizador autenticado ou anónimo,
    // atualização para votos/views ou pelo proprietário.
    match /tierlists/{listId} {
      allow read: if resource.data.visibility != 'private' || (request.auth != null && request.auth.uid == resource.data.ownerId);
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Catálogo de itens reais verificado
    match /items_catalog/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categorias reais
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comentários por tier list
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Sistema de votos anti-abuso
    match /votes/{voteId} {
      allow read, write: if true;
    }
  }
}