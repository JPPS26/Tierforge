rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only create/edit their own profile document.
    // Perfis de utilizador
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Tier lists are publicly readable, but only their owner can write them.
    // Tier lists são públicas para leitura; criação pelo autor ou anónimo;
    // Atualizações permitidas para votos/visualizações ou pelo proprietário.
    match /tierlists/{listId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Catálogo de itens reais verificado
    match /items_catalog/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comentários por tier list
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
