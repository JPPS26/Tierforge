rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de utilizador: leitura pública para todos, escrita apenas com conta própria
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Tier lists: leitura pública para todos, criação e edição apenas com conta
    match /tierlists/{listId} {
      allow read: if resource.data.visibility != 'private' || (request.auth != null && request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Catálogo de itens reais: leitura pública, criação de novos itens apenas com conta
    match /items_catalog/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categorias: leitura pública, propor novas categorias apenas com conta
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comentários e respostas: leitura pública, publicação e reações apenas com conta
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Votos e Likes: leitura pública para todos, votar apenas com conta autenticada
    match /votes/{voteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}